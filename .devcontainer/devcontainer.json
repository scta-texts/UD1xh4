{
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "remoteUser": "node",
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.claude",
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y socat && npm install -g @anthropic-ai/claude-code",
  "postStartCommand": "socat TCP-LISTEN:3001,fork,reuseaddr TCP:host.docker.internal:3001 &",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
		"raffazizzi.sxml",
		"ms-vsliveshare.vsliveshare",
		"formulahendry.auto-close-tag",
		"formulahendry.auto-rename-tag",
		"Compulim.compulim-vscode-closetag",
		"DotJoshJohnson.xml",
	        "streetsidesoftware.code-spell-checker",
    		"streetsidesoftware.code-spell-checker-latin"
	],
      "settings": {
        "editor.tabSize": 2,
        "editor.renderWhitespace": "all",
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
	"cSpellExt_latin.enable": true,
        "cSpell.language": "en,la",
        "cSpell.enableFiletypes": [
          "xml"
        ]
      }
    }
  }
}
